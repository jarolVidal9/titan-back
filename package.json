{
  "name": "titan-api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend de TITAN: sesión y sincronización offline-first (Express + Turso/libSQL).",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
